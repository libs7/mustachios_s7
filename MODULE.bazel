module(
    name                = "mustachios_s7",
    version             = "3.0.0",
    compatibility_level = 3,
    bazel_compatibility = [">=8.0.0"]
)

## bcr:
bazel_dep(name = "platforms",       version = "0.0.11")
bazel_dep(name = "bazel_skylib",    version = "1.7.1")
bazel_dep(name = "rules_cc",        version = "0.1.1")

## obazl:
bazel_dep(name = "obazl_tools_cc",  version = "3.0.0")
git_override(module_name = "obazl_tools_cc",
             branch  = "3.0.0.dev",
             remote = "https://github.com/obazl/obazl_tools_cc.git"
             )

bazel_dep(name = "liblogc",         version = "3.0.0")
bazel_dep(name = "makeheaders",     version = "3.0.0")
bazel_dep(name = "mustachios",      version = "3.0.0")
git_override(module_name = "mustachios",
             branch  = "bazel",
             remote = "git@gitlab.com:obazl/mustachios.git")

bazel_dep(name = "libs7",           version = "3.0.0")
git_override(module_name = "libs7",
             branch  = "3.0.0.dev",
             remote = "https://github.com/libs7/libs7.git")
bazel_dep(name = "cjson_s7",        version = "1.7.18")
git_override(module_name = "cjson_s7",
             branch  = "1.7.18.dev",
             remote = "https://github.com/libs7/cjson_s7.git")
bazel_dep(name = "dune_s7",         version = "3.0.0")
git_override(module_name = "dune_s7",
             branch  = "3.0.0.dev",
             remote = "https://github.com/libs7/dune_s7.git")
bazel_dep(name = "toml_s7",         version = "3.0.0")
git_override(module_name = "toml_s7",
             branch  = "3.0.0.dev",
             remote = "https://github.com/libs7/toml_s7.git")
# toml_s7 dep:
bazel_dep(name = "tomlc",          version = "3.0.0")
git_override(module_name = "tomlc",
             branch  = "3.0.0.dev",
             remote = "https://github.com/obazl/tomlc.git")

# dev deps
bazel_dep(name = "gopt",            version = "10.0.0",
          dev_dependency=True)
bazel_dep(name = "uthash",          version = "2.3.0.bzl",
          dev_dependency=True)
bazel_dep(name = "unity",           version = "2.6.1.bzl",
          dev_dependency=True)
